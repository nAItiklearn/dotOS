<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.live_wallpaper" android:required="false" />
    <application>
        <service
            android:name="com.dotos.feature.wallpaper.service.DotWallpaperService"
            android:exported="true"
            android:label="@string/dot_wallpaper_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/dot_wallpaper" />
        </service>
    </application>
</manifest>
