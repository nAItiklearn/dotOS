<?xml version="1.0" encoding="utf-8"?>
<!--
    4x2 Dot Clock: date line on top, one big "HH:mm" in Doto below it (system 12 / 24 h preference).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dotg_clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dotg_plate"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/dotg_clock_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:fontFamily="@font/space_mono"
            android:format12Hour="EEEE d MMMM"
            android:format24Hour="EEEE d MMMM"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="@color/dotg_muted"
            android:textSize="12sp" />

        <TextClock
            android:id="@+id/dotg_clock_time"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="96sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/doto"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/dotg_on"
            android:textSize="48sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_gravity="top|end"
        android:importantForAccessibility="no"
        android:src="@drawable/dotg_dot_red" />
</FrameLayout>
