<?xml version="1.0" encoding="utf-8"?>
<!-- Static picker preview for Dot Clock at 2x2. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dotg_plate"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:fontFamily="@font/space_mono"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="TUE 10 NOV"
            android:textColor="@color/dotg_muted"
            android:textSize="11sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="72sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/doto"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="09"
            android:textColor="@color/dotg_on"
            android:textSize="32sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="72sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/doto"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="41"
            android:textColor="@color/dotg_on"
            android:textSize="32sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <ImageView
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_gravity="top|end"
        android:importantForAccessibility="no"
        android:src="@drawable/dotg_dot_red" />
</FrameLayout>
