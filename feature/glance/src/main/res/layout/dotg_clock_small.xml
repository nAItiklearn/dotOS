<?xml version="1.0" encoding="utf-8"?>
<!--
    2x2 Dot Clock. Hours stacked over minutes in Doto. TextClock ticks on its own, so the widget never needs an update.
    Only RemoteViews-safe classes are used (FrameLayout, LinearLayout, TextClock, ImageView).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dotg_clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dotg_plate"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/dotg_clock_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:fontFamily="@font/space_mono"
            android:format12Hour="EEE d MMM"
            android:format24Hour="EEE d MMM"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="@color/dotg_muted"
            android:textSize="11sp" />

        <TextClock
            android:id="@+id/dotg_clock_hours"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="72sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/doto"
            android:format12Hour="hh"
            android:format24Hour="HH"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/dotg_on"
            android:textSize="32sp" />

        <TextClock
            android:id="@+id/dotg_clock_minutes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="72sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/doto"
            android:format12Hour="mm"
            android:format24Hour="mm"
            android:gravity="start|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/dotg_on"
            android:textSize="32sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_gravity="top|end"
        android:importantForAccessibility="no"
        android:src="@drawable/dotg_dot_red" />
</FrameLayout>
